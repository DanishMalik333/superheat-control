        (* End of Outputs for SubSystem: '<S1>/Calculating Free Response' *)
        
        (* Sum: '<S5>/Diff' incorporates:
         *  UnitDelay: '<S5>/UD'
         *
         * Block description for '<S5>/Diff':
         *  
         *  Add in CPU
         *
         * Block description for '<S5>/UD':
         *  
         *  Store in Global RAM *)
        Diff := rtb_UnitDelay - UD_DSTATE;
        (* S-Function (sfix_udelay): '<S3>/Tapped Delay' *)
        rtb_TappedDelay[DINT#0] := Diff;
        FOR i := DINT#0 TO DINT#1498 DO 
            rtb_TappedDelay[i + DINT#1] := TappedDelay_X[i];
        END_FOR;
        (* End of S-Function (sfix_udelay): '<S3>/Tapped Delay' *)
        
        (* Gain: '<S3>/Gain' *)
        rtb_Dy := LREAL#0.0;
        FOR i := DINT#0 TO DINT#1499 DO 
            rtb_Dy := (Gain_Gain[i] * rtb_TappedDelay[i]) + rtb_Dy;
        END_FOR;
        (* End of Gain: '<S3>/Gain' *)
        
        (* Sum: '<S1>/Sum2' incorporates:
         *  Delay: '<S3>/Delay One Step'
         *  Sum: '<S3>/Sum1' *)
        rtb_Dy := y - (DelayOneStep_DSTATE[DINT#0] + rtb_Dy);
        (* Gain: '<S1>/Gain1' *)
        rtb_Gain1_idx_0 := LREAL#0.0;
        FOR i := DINT#0 TO DINT#199 DO 
            (* Outputs for Atomic SubSystem: '<S1>/Calculating Free Response' *)
            (* Gain: '<S1>/Gain1' incorporates:
             *  Gain: '<S2>/Gain3'
             *  Sum: '<S1>/Sum'
             *  Sum: '<S1>/Sum3'
             *  Sum: '<S2>/Sum3' *)
            rtb_Gain1_idx_0 := (Gain1_Gain[i * DINT#2] * (b_r - ((rtb_Sum_0[i] + rtb_TappedDelay1[i]) + rtb_Dy))) + rtb_Gain1_idx_0;
            (* End of Outputs for SubSystem: '<S1>/Calculating Free Response' *)
        END_FOR;
        (* Saturate: '<S1>/Saturation' incorporates:
         *  Fcn: '<S1>/Fcn' *)
        IF rtb_Gain1_idx_0 > LREAL#0.1 THEN 
            rtb_Dy := LREAL#0.1;
        ELSIF rtb_Gain1_idx_0 >= LREAL#-0.1 THEN 
            rtb_Dy := rtb_Gain1_idx_0;
        ELSE 
            rtb_Dy := LREAL#-0.1;
        END_IF;
        (* End of Saturate: '<S1>/Saturation' *)
        
        (* DiscreteTransferFcn: '<S1>/Discrete Transfer Fcn1' *)
        u := rtb_Dy - ( -DiscreteTransferFcn1_states);
        (* Update for UnitDelay: '<S1>/Unit Delay' incorporates:
         *  DiscreteTransferFcn: '<S1>/Discrete Transfer Fcn1' *)
        UnitDelay_DSTATE := u;
        (* Update for Delay: '<S3>/Delay One Step' *)
        FOR i := DINT#0 TO DINT#1498 DO 
            DelayOneStep_DSTATE[i] := DelayOneStep_DSTATE[i + DINT#1];
        END_FOR;
        DelayOneStep_DSTATE[DINT#1499] := rtb_UnitDelay;
        (* End of Update for Delay: '<S3>/Delay One Step' *)
        
        (* Update for UnitDelay: '<S5>/UD'
         *
         * Block description for '<S5>/UD':
         *  
         *  Store in Global RAM *)
        UD_DSTATE := rtb_UnitDelay;
        (* Update for S-Function (sfix_udelay): '<S3>/Tapped Delay' *)
        FOR i := DINT#0 TO DINT#1497 DO 
            TappedDelay_X[DINT#1498 - i] := TappedDelay_X[DINT#1497 - i];
        END_FOR;
        TappedDelay_X[DINT#0] := Diff;
        (* End of Update for S-Function (sfix_udelay): '<S3>/Tapped Delay' *)
        
        (* Update for DiscreteTransferFcn: '<S1>/Discrete Transfer Fcn1' *)
        DiscreteTransferFcn1_states := u;
        (* End of Outputs for SubSystem: '<Root>/MPC DMC' *)
END_CASE;
END_FUNCTION_BLOCK
