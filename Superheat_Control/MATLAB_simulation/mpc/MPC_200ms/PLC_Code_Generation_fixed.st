        (* '<S3>:1:7' SS_1N  = SS(1:N); *)
        (* 1x150 row vector — feeds the "SS(1:N)*u" gain *)
        (* '<S3>:1:8' SS_N1  = SS(N+1); *)
        (* scalar — feeds both "SS(N+1)" gains (ss_gain in the other block too) *)
        (* ---- lazy init on first call only (isempty check is codegen-legal) ---- *)
        (* '<S3>:1:11' if isempty(u150_hist) *)
        (* '<S3>:1:17' if numel(SS_1N) ~= N *)
        (* '<S3>:1:21' if ~isscalar(SS_N1) *)
        (* '<S3>:1:25' SS_1N_row = reshape(SS_1N, 1, N); *)
        (* ensure 1xN row for the dot product *)
        (* ---- top branch ---- *)
        (* '<S3>:1:28' u150_k = u150_hist(1); *)
        u150_k := u150_hist[DINT#0];
        (* oldest entry = u[k-N] *)
        (* '<S3>:1:29' y1 = SS_N1 * u150_k; *)
        (* scalar *)
        (* '<S3>:1:31' u150_hist = [u150_hist(2:end); u_k]; *)
        (* shift in current u, drop oldest *)
        (* ---- bottom branch ---- *)
        (* '<S3>:1:34' du_k = u_k - u_prev; *)
        du_k := UnitDelay_DSTATE - u_prev;
        (* Difference: (z-1)/z *)
        (* '<S3>:1:35' u_prev = u_k; *)
        u_prev := UnitDelay_DSTATE;
        (* End of Outputs for SubSystem: '<Root>/MPC DMC' *)
        (* w = [du_k, du(k-1), ..., du(k-149)], newest->oldest, current first *)
        (* '<S3>:1:38' w = [du_k; flipud(du_hist)]; *)
        (* Outputs for Atomic SubSystem: '<Root>/MPC DMC' *)
        (* MATLAB Function: '<S1>/Model' incorporates:
         *  UnitDelay: '<S1>/Unit Delay' *)
        FOR i := DINT#0 TO DINT#148 DO 
            u150_hist[i] := u150_hist[i + DINT#1];
            x[i] := du_hist[i];
        END_FOR;
        u150_hist[DINT#149] := UnitDelay_DSTATE;
        FOR i := DINT#0 TO DINT#73 DO 
            xtmp := x[i];
            x[i] := x[DINT#148 - i];
            x[DINT#148 - i] := xtmp;
        END_FOR;
        (* 150x1 *)
        (* '<S3>:1:40' y2 = SS_1N_row * w; *)
        (* 1x150 * 150x1 -> scalar *)
        (* '<S3>:1:42' du_hist = [du_hist(2:end); du_k]; *)
        FOR i := DINT#0 TO DINT#147 DO 
            du_hist[i] := du_hist[i + DINT#1];
        END_FOR;
        du_hist[DINT#148] := du_k;
        (* End of Outputs for SubSystem: '<Root>/MPC DMC' *)
        (* shift in current du, drop oldest *)
        (* ---- combine ---- *)
        (* '<S3>:1:45' ym = y1 + y2; *)
        (* scalar *)
        (* Outputs for Atomic SubSystem: '<Root>/MPC DMC' *)
        (* MATLAB Function: '<S1>/Model' *)
        du_k_0[DINT#0] := du_k;
        FOR i := DINT#0 TO DINT#148 DO 
            du_k_0[i + DINT#1] := x[i];
        END_FOR;
        rtb_u := LREAL#0.0;
        FOR i := DINT#0 TO DINT#149 DO 
            rtb_u := (Model_SS[i] * du_k_0[i]) + rtb_u;
        END_FOR;
        (* Sum: '<S1>/Sum2' incorporates:
         *  MATLAB Function: '<S1>/Model' *)
        xtmp := y - ((LREAL#19.906243860199364 * u150_k) + rtb_u);
        (* Gain: '<S1>/Gain1' *)
        rtb_Gain1_idx_0 := LREAL#0.0;
        FOR i := DINT#0 TO DINT#49 DO 
            (* MATLAB Function: '<S1>/Calculating Free Response' *)
            rtb_u := LREAL#0.0;
            FOR i_0 := DINT#0 TO DINT#147 DO 
                rtb_u := (CalculatingFreeResponse_H[(DINT#50 * i_0) + i] * v[i_0]) + rtb_u;
            END_FOR;
            (* Gain: '<S1>/Gain1' incorporates:
             *  MATLAB Function: '<S1>/Calculating Free Response'
             *  Sum: '<S1>/Sum'
             *  Sum: '<S1>/Sum3' *)
            rtb_Gain1_idx_0 := (Gain1_Gain[i * DINT#2] * (b_r - (((LREAL#19.906243860199364 * w[i]) + rtb_u) + xtmp))) + rtb_Gain1_idx_0;
        END_FOR;
        (* Saturate: '<S1>/Saturation' incorporates:
         *  Fcn: '<S1>/Fcn'
         *  Gain: '<S1>/Gain1' *)
        IF rtb_Gain1_idx_0 > LREAL#0.2 THEN 
            xtmp := LREAL#0.2;
        ELSIF rtb_Gain1_idx_0 >= LREAL#-0.2 THEN 
            xtmp := rtb_Gain1_idx_0;
        ELSE 
            xtmp := LREAL#-0.2;
        END_IF;
        (* End of Saturate: '<S1>/Saturation' *)
        
        (* DiscreteTransferFcn: '<S1>/Discrete Transfer Fcn1' *)
        rtb_u := xtmp - ( -DiscreteTransferFcn1_states);
        (* Saturate: '<S1>/Saturation1' incorporates:
         *  DiscreteTransferFcn: '<S1>/Discrete Transfer Fcn1' *)
        IF rtb_u > LREAL#0.9 THEN 
            xtmp := LREAL#0.9;
        ELSIF rtb_u >= LREAL#0.1 THEN 
            xtmp := rtb_u;
        ELSE 
            xtmp := LREAL#0.1;
        END_IF;
        (* End of Saturate: '<S1>/Saturation1' *)
        
        (* Update for UnitDelay: '<S1>/Unit Delay' incorporates:
         *  DiscreteTransferFcn: '<S1>/Discrete Transfer Fcn1' *)
        UnitDelay_DSTATE := rtb_u;
        (* Update for DiscreteTransferFcn: '<S1>/Discrete Transfer Fcn1' *)
        DiscreteTransferFcn1_states := rtb_u;
        (* Outport: '<Root>/u' incorporates:
         *  Gain: '<S1>/Gain' *)
        u := LREAL#100.0 * xtmp;
        (* End of Outputs for SubSystem: '<Root>/MPC DMC' *)
END_CASE;
